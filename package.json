{
  "name": "koc-roster-update",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --doctor",
    "configure": "node scripts/setup.mjs --configure",
    "readiness": "node scripts/run.mjs readiness",
    "koc:daily": "node scripts/run.mjs daily",
    "koc:one-shot": "node scripts/run.mjs one-shot",
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "node --test runtime/koc-contact/*.test.mjs runtime/koc-roster/*.test.mjs",
    "connect": "node scripts/run.mjs connect",
    "capture-session": "node scripts/run.mjs capture-session",
    "initialize-base": "node scripts/run.mjs initialize-base",
    "bootstrap-background": "node scripts/run.mjs bootstrap-background"
  },
  "dependencies": {
    "@playwright/cli": "0.1.21",
    "exceljs": "4.4.0",
    "playwright": "1.63.0",
    "@larksuite/cli": "1.0.97"
  }
}
